# PostgreSQL connection for MoneyBall DB (SQLAlchemy + psycopg v3)
# Copy this file to .env and adjust credentials for your local machine.
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/moneyball

# Tiingo API token (also supported via .env.local — never commit real secrets)
TIINGO_API_TOKEN=your_tiingo_api_token_here
